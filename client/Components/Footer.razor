<footer style="background-color: #1F2A24; color: #FFFFFF; border-top: 1px solid #2D3B33;" class="py-10 px-6 mt-16">
    <div style="max-width: 1200px; margin: 0 auto;">
        <MudGrid Class="justify-space-between align-center">
    
            <MudItem xs="12" md="4">
                <div class="d-flex align-center gap-2 mb-2">

                    <div style="background-color: #DE5844; border-radius: 8px; width: 28px; height: 28px;" class="d-flex align-center justify-center">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Style="color: white; font-size: 18px;" />
                    </div>
                    <span style="font-size: 20px; font-weight: 700; color: #FFFFFF;">
                        NearBuy
                    </span>
                </div>
                <MudText Typo="Typo.body2" Style="color: #93A398; font-size: 13px;">
                    Good finds. Close neighbors. Less waste.
                </MudText>
            </MudItem>


            <MudItem xs="12" md="5" Class="d-flex justify-center flex-wrap gap-6">
                <a href="/" style="color: #E2EFE7; text-decoration: none; font-size: 14px; font-weight: 500;">Browse</a>
                <a href="#" style="color: #E2EFE7; text-decoration: none; font-size: 14px; font-weight: 500;">Safety</a>
                <a href="#" style="color: #E2EFE7; text-decoration: none; font-size: 14px; font-weight: 500;">Community Guidelines</a>
                <a href="#" style="color: #E2EFE7; text-decoration: none; font-size: 14px; font-weight: 500;">Help</a>
            </MudItem>


            <MudItem xs="12" md="3" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled" 
                           Href="/post-item"
                           Style="background-color: #DE5844; color: white; border-radius: 20px; text-transform: none; font-weight: 600; padding: 8px 20px;">
                    Post something useful
                </MudButton>
            </MudItem>

        </MudGrid>
    </div>
</footer>